# --- Core -------------------------------------------------------------------
PORT=8080
# Local Postgres, or the Railway-provided URL in production.
DATABASE_URL=postgres://localhost:5432/cvc
# Origins allowed to call this API, comma-separated (the Vite dev server locally;
# the Pages domain + preview domain in production).
ALLOWED_ORIGIN=http://localhost:5173

# --- Admin auth -------------------------------------------------------------
# Comma-separated allowlist. Only these addresses can request a login link.
ADMIN_EMAILS=cameron@blacktagdevs.com
# Any long random string: `openssl rand -hex 32`
SESSION_JWT_SECRET=change-me
# Where the magic link drops you back into the SPA.
ADMIN_APP_URL=http://localhost:5173/admin

# Local-only shortcut: POST /admin/auth/dev-login issues a session with no email
# round-trip. Ignored whenever NODE_ENV=production.
DEV_ADMIN_BYPASS=true

# --- Publishing -------------------------------------------------------------
# Cloudflare Pages deploy hook. Public pages are prerendered at build time, so a
# change she publishes only reaches the site once this fires a rebuild. Unset
# means the rebuild request is logged instead of sent.
PAGES_DEPLOY_HOOK_URL=
# Seconds to wait after the last published change before rebuilding, so a burst
# of edits produces one build rather than ten.
PUBLISH_DEBOUNCE_SECONDS=60

# --- Email (optional) -------------------------------------------------------
# Without these the magic link is printed to the server console instead of sent.
LOOPS_API_KEY=
LOOPS_MAGIC_LINK_TEMPLATE_ID=

# --- Image storage (optional) ----------------------------------------------
# Without these, /admin/upload returns 503 and the admin UI keeps images inline
# as base64 data URIs — fine for local dev, not for a real gallery.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=blacktag-media
R2_PUBLIC_BASE=
R2_PREFIX=cvc

# --- Core -------------------------------------------------------------------
PORT=8080
# Local Postgres, or the Railway-provided URL in production.
DATABASE_URL=postgres://localhost:5432/cvc
# Origins allowed to call this API, comma-separated (the Vite dev server locally;
# https://blacktagdevs.github.io, then the custom domain, in production).
ALLOWED_ORIGIN=http://localhost:5173

# --- Admin auth -------------------------------------------------------------
# Comma-separated allowlist. Only these addresses can request a login link.
ADMIN_EMAILS=cameron@blacktagdevs.com
# Any long random string: `openssl rand -hex 32`
SESSION_JWT_SECRET=change-me
# Where the magic link drops you back into the SPA.
ADMIN_APP_URL=http://localhost:5173/admin

# Local-only shortcut: POST /admin/auth/dev-login issues a session with no email
# round-trip. Ignored whenever NODE_ENV=production.
DEV_ADMIN_BYPASS=true

# --- Publishing -------------------------------------------------------------
# Public pages are prerendered and served by GitHub Pages, so a change she
# publishes only reaches the site once the deploy workflow runs again. The API
# starts it through GitHub with a fine-grained token scoped to this one repo
# with "Actions: Read and write". Unset means the rebuild is logged, not sent.
GITHUB_DEPLOY_TOKEN=
GITHUB_REPO=blacktagdevs/creative-vision-consultancy
GITHUB_DEPLOY_WORKFLOW=deploy-pages.yml
GITHUB_DEPLOY_REF=main
# Seconds to wait after the last published change before rebuilding, so a burst
# of edits produces one build rather than ten.
PUBLISH_DEBOUNCE_SECONDS=60

# --- Email (optional) -------------------------------------------------------
# Without these the magic link is printed to the server console instead of sent.
LOOPS_API_KEY=
LOOPS_MAGIC_LINK_TEMPLATE_ID=

# --- Image storage (Cloudflare Images) --------------------------------------
# Shared BlackTag account; CVC uploads are tagged project=cvc and only those are
# ever deleted. Without these, /admin/upload returns 503; locally the admin then
# keeps images inline as base64 (never in production).
CF_ACCOUNT_ID=
CF_IMAGES_ACCOUNT_HASH=
# API token with Account → Cloudflare Images → Edit.
CF_IMAGES_TOKEN=
